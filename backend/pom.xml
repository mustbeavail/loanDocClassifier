<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot가 제공하는 부모 POM. 라이브러리 버전들을 대신 관리해 준다 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.codingtest</groupId>
	<artifactId>doc-classifier</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>doc-classifier</name>
	<description>대출 서류 PDF 페이지 분류 백엔드</description>

	<properties>
		<java.version>21</java.version>
		<pdfbox.version>3.0.7</pdfbox.version>
		<tess4j.version>5.16.0</tess4j.version>
		<genai.version>1.61.0</genai.version>
	</properties>

	<dependencies>
		<!-- REST API 서버 (Spring MVC + 내장 톰캣) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- PDF 파싱: 페이지별 텍스트 추출, 이미지 렌더링에 사용 -->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>${pdfbox.version}</version>
		</dependency>

		<!-- OCR: 텍스트 레이어가 없는 스캔 페이지를 글자로 변환한다.
		     Tesseract 엔진의 자바 래퍼이며, 네이티브 라이브러리와 영어 데이터를 함께 배포한다 -->
		<dependency>
			<groupId>net.sourceforge.tess4j</groupId>
			<artifactId>tess4j</artifactId>
			<version>${tess4j.version}</version>
		</dependency>

		<!-- LLM: 규칙으로 판정하지 못한 페이지를 문맥으로 분류한다 -->
		<dependency>
			<groupId>com.google.genai</groupId>
			<artifactId>google-genai</artifactId>
			<version>${genai.version}</version>
		</dependency>

		<!-- 테스트 (JUnit 5, AssertJ, MockMvc 포함) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
